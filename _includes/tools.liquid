<div class="tools row row-cols-1 row-cols-md-2">
  {% for tool in site.data.tools %}
    <div class="col mb-3">
      <div class="card h-100 hoverable">
        <div class="card-body d-flex">
          {% if tool.icon %}
            <img class="tool-icon mr-3" src="{{ tool.icon | prepend: '/assets/img/tools/' | relative_url }}" alt="{{ tool.name }} icon" loading="lazy">
          {% endif %}
          <div>
          <h5 class="card-title mb-1">
            <a href="{{ tool.github }}" target="_blank" rel="noopener noreferrer">{{ tool.name }}</a>
            {% if tool.badge %}<span class="badge tool-badge ml-1">{{ tool.badge }}</span>{% endif %}
          </h5>
          <p class="card-text mb-2">{{ tool.description }}</p>
          <div class="tool-links">
            <a href="{{ tool.github }}" target="_blank" rel="noopener noreferrer">{% if tool.link_label %}<i class="fa-solid fa-link"></i> {{ tool.link_label }}{% else %}<i class="fa-brands fa-github"></i> Code{% endif %}</a>
            {% if tool.paper %}
              &nbsp;·&nbsp;<a href="{{ '/publications/' | relative_url }}#{{ tool.paper }}"><i class="fa-solid fa-file-lines"></i> Paper</a>
            {% endif %}
          </div>
          </div>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
